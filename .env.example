# --- Content generation ---
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8        # optional override

# --- Instagram (Business/Creator account linked to a Facebook Page) ---
# Get via Meta developer app with instagram_content_publish permission.
IG_USER_ID=1784...
IG_ACCESS_TOKEN=EAAG...

# --- Threads (Threads API app with threads_content_publish permission) ---
THREADS_USER_ID=1234...
THREADS_ACCESS_TOKEN=TH...

# --- LinkedIn (app with w_member_social / Community Management API) ---
LINKEDIN_ACCESS_TOKEN=AQX...
LINKEDIN_AUTHOR_URN=urn:li:person:XXXX   # or urn:li:organization:XXXX
# LINKEDIN_VERSION=202506                # optional API version override

# --- Hosting for Instagram/Threads image fetches ---
# Default in GitHub Actions: raw.githubusercontent.com URLs of this repo
# (repo must be PUBLIC for that to work). Otherwise point at your own host:
# PUBLIC_IMAGE_BASE_URL=https://cdn.example.com/carousels

# --- Behavior ---
# PLATFORMS=instagram,threads,linkedin   # subset to publish to
# POST_DATE=2026-07-12                   # operate on a specific date folder
# CHROMIUM_PATH=/opt/pw-browsers/chromium  # use a pre-installed browser
